# Next.js: .env.local overrides .env. Do not leave the Supabase vars below empty in .env.local
# or they will override real values in .env and break auth/middleware.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Public site URL for event QR codes and canonical links (production: https://mercatocapital.xyz)
NEXT_PUBLIC_APP_URL=https://mercatocapital.xyz
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_DATABASE="postgres"
POSTGRES_HOST=

# Trustless Work (Stellar escrow)
NEXT_PUBLIC_TRUSTLESS_WORK_API_KEY=
NEXT_PUBLIC_TRUSTLESS_NETWORK=testnet
NEXT_PUBLIC_MERCATO_PLATFORM_ADDRESS=
NEXT_PUBLIC_TRUSTLESSLINE_ADDRESS=
# Classic USDC issuer for direct investor→supplier payments (optional; defaults by network)
# Testnet Circle: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_ISSUER=
# DeFindex — Mercato vault (Soroban). API key must be server-only in production.
# Prefer DEFINDEX_API_KEY in .env / Vercel env (never NEXT_PUBLIC_* for the secret).
DEFINDEX_API_KEY=
DEFINDEX_API_URL=
# Optional: override public vault id for server (else NEXT_PUBLIC_DEFINDEX_VAULT_ADDRESS is used)
MERCATO_DEFINDEX_VAULT_ADDRESS=
NEXT_PUBLIC_DEFINDEX_VAULT_ADDRESS=
# Raw on-chain amounts usually use 7 decimals (Stellar USDC)
NEXT_PUBLIC_DEFINDEX_ASSET_DECIMALS=7
# Legacy / local dev only — exposes key to the browser; prefer DEFINDEX_API_KEY
# NEXT_PUBLIC_DEFINDEX_API_KEY=
# NEXT_PUBLIC_DEFINDEX_API_URL=https://api.defindex.io

# RWA funding pools (Soroban credit-registry / credit-funding contracts).
# RWA_ENABLED gates the RWA contribution API. The network is taken from
# NEXT_PUBLIC_TRUSTLESS_NETWORK, so the two must agree.
RWA_ENABLED=false
# Credit registry contract that owns the frozen asset terms (optional: each
# asset row carries its own registry and pool contract ids).
# Testnet deploy 2026-11-10: CD5G343KUP7KN3O22FRH43MMMLEMZKU2DQBHHCGVAPT7S3IUUMMWHXSF
RWA_REGISTRY_CONTRACT_ID=
# USDC Stellar Asset Contract the funding pools are denominated in. When set,
# a pool whose recorded token differs is refused, which guards the unit
# conversion between display amounts and base units.
# Testnet Circle USDC SAC: CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
RWA_USDC_SAC_ADDRESS=
# Registry admin account. register_asset and create_funding_pool require this signer.
# Testnet admin (CLI identity mercato-rwa-testnet): GAGZSSVI7IJ7G4B57SCOPHFYV3YSS76ONOC22XOOEF47SP4OZJPG4BXS
RWA_REGISTRY_ADMIN_ADDRESS=
# Optional Soroban RPC override (defaults to the public endpoint per network).
RWA_SOROBAN_RPC_URL=

# Pollar (embedded wallet onboarding)
# In dashboard.pollar.xyz → Domains, add each origin you use (e.g. http://localhost:3000 — exact scheme host port).
# Missing origin causes API errors like ORIGIN_NOT_ALLOWED on Google/GitHub login.
# Server-side verification forwards the browser Origin; if your proxy strips it, set the same URL here:
# POLLAR_ALLOWED_ORIGIN=http://localhost:3000
# For API routes (/api/auth/pollar-sync), duplicate your publishable key here so the server always has it
# (some Next setups resolve NEXT_PUBLIC_* inconsistently on the server).
POLLAR_PUBLISHABLE_KEY=
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=
POLLAR_WEBHOOK_SECRET=
NEXT_PUBLIC_POLLAR_NETWORK=testnet

